rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rules run on Google's servers and cannot read Vite env vars, so the
    // admin address is hardcoded here. This is the authoritative check --
    // the ADMIN_EMAIL comparison in src/context/AuthContext.tsx is only a
    // UI convenience and is trivially bypassed in the browser.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified
             && request.auth.token.email == 'REPLACE_WITH_ADMIN_EMAIL';
    }

    // Site content is public to read, admin-only to change.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
